# --- Docker / MariaDB ---
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=thedoghabit_wp
MYSQL_USER=thedoghabit
MYSQL_PASSWORD=changeme

# --- WordPress core install (koristi ih setup_wordpress.sh) ---
WP_ADMIN_USER=thedoghabit_admin
WP_ADMIN_PASSWORD=changeme
WP_ADMIN_EMAIL=you@example.com

# --- generate_post.py runtime ---
WP_URL=http://127.0.0.1:8092
WP_USER=autopost
WP_APP_PASSWORD=

# --- vanjski API-ji ---
LUMENTA_API_URL=https://lumenta.shop
LUMENTA_API_KEY=changeme
LEONARDO_API_KEY=changeme

# --- alerting (opcionalno; bez ovoga se alerti samo preskaču) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Make.com ---
MAKE_WEBHOOK_SECRET=

# --- generate_video.py ---
# edge-tts glas (besplatno, bez ključa): popis glasova -> edge-tts --list-voices
EDGE_TTS_VOICE=en-US-AndrewMultilingualNeural
# ffmpeg/ffprobe binari ako nisu na PATH-u
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# YouTube Data API v3 (Google Cloud OAuth client tipa "Desktop app");
# YT_REFRESH_TOKEN dobiješ jednokratno preko: python scripts/generate_video.py --yt-auth
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# private dok kvaliteta nije potvrđena; kasnije public
YT_PRIVACY=private
